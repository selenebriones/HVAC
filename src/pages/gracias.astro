---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gracias por contactarnos - MXHVAC" minimal>
	<section class="min-h-screen flex items-center justify-center relative overflow-hidden py-24">
		<div class="absolute inset-0 bg-secondary"></div>
		<div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,210,255,0.15)_0%,rgba(10,25,47,1)_80%)]"></div>

		<div class="container mx-auto px-6 relative z-10 max-w-2xl text-center">
			<div class="backdrop-glass p-10 md:p-14 rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10">
				<i class="ph-bold ph-check-circle text-6xl text-accent mb-6"></i>
				<h1 class="text-3xl md:text-5xl font-bold text-white mb-4">¡Gracias por contactarnos!</h1>
				<p class="text-gray-300 text-lg leading-relaxed mb-10">Hemos recibido tu mensaje. En breve un asesor se comunicará contigo.</p>
				<a href="/" class="inline-flex items-center justify-center px-8 py-4 bg-accent text-secondary font-bold rounded-full hover:bg-white transition-all shadow-[0_0_20px_rgba(0,210,255,0.3)] hover:shadow-[0_0_30px_rgba(255,255,255,0.6)] hover:-translate-y-1 group">
					<i class="ph-bold ph-arrow-left mr-2 group-hover:-translate-x-1 transition-transform"></i>
					Volver al inicio
				</a>
			</div>
		</div>
	</section>
</Layout>
