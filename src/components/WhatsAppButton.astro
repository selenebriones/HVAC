---
interface Props {
	phone?: string;
	message?: string;
}

const {
	phone = '528112271165',
	message = '¡Hola! Me interesa solicitar información o una cotización para un proyecto de HVAC / Generación Eléctrica para mi empresa. ¿Podrían orientarme?',
} = Astro.props;

const href = `https://wa.me/${phone}?text=${encodeURIComponent(message)}`;
---

<a
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class="wa-float"
	aria-label="Escríbenos por WhatsApp"
	title="Escríbenos por WhatsApp"
>
	<svg viewBox="0 0 32 32" aria-hidden="true" focusable="false">
		<path
			fill="currentColor"
			d="M16.004 3.2c-7.07 0-12.8 5.73-12.8 12.8 0 2.26.6 4.47 1.73 6.42L3.2 28.8l6.55-1.7a12.74 12.74 0 0 0 6.25 1.62h.01c7.06 0 12.8-5.73 12.8-12.8 0-3.42-1.33-6.63-3.75-9.05a12.71 12.71 0 0 0-9.06-3.75Zm0 23.07h-.01a10.6 10.6 0 0 1-5.4-1.48l-.39-.23-4.02 1.05 1.07-3.92-.25-.4a10.57 10.57 0 0 1-1.62-5.65c0-5.87 4.78-10.64 10.65-10.64 2.84 0 5.51 1.11 7.52 3.12a10.57 10.57 0 0 1 3.12 7.53c0 5.87-4.78 10.63-10.65 10.63Zm5.84-7.97c-.32-.16-1.89-.93-2.18-1.04-.29-.11-.5-.16-.71.16-.21.32-.82 1.04-1 1.25-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.89-1.78-2.21-.19-.32-.02-.5.14-.66.14-.14.32-.37.48-.56.16-.19.21-.32.32-.53.11-.21.05-.4-.03-.56-.08-.16-.71-1.73-.98-2.36-.26-.62-.52-.54-.71-.55l-.61-.01c-.21 0-.56.08-.85.4-.29.32-1.11 1.09-1.11 2.65s1.14 3.08 1.3 3.29c.16.21 2.24 3.42 5.43 4.8.76.33 1.35.52 1.81.67.76.24 1.45.21 2 .13.61-.09 1.89-.77 2.15-1.52.27-.74.27-1.38.19-1.51-.08-.13-.29-.21-.61-.37Z"
		/>
	</svg>
</a>

<style>
	/* Alineado con el botón del chat de Conversia (.chatbot-toggler): 55px, bottom 35px */
	.wa-float {
		position: fixed;
		left: 40px;
		bottom: 35px;
		z-index: 60;
		display: flex;
		align-items: center;
		justify-content: center;
		width: 55px;
		height: 55px;
		border-radius: 9999px;
		background: #4ac959;
		color: #fff;
		transition:
			transform 0.25s ease,
			background-color 0.25s ease;
	}

	.wa-float svg {
		width: 60%;
		height: 60%;
		display: block;
	}

	.wa-float:hover,
	.wa-float:focus-visible {
		background: #3fb94e;
		transform: scale(1.06);
	}

	.wa-float:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 3px;
	}

	@media (prefers-reduced-motion: reduce) {
		.wa-float {
			transition: none;
		}
		.wa-float:hover {
			transform: none;
		}
	}
</style>
